{
  "groups": [
    {
      "name": "latency.rules",
      "rules": [
        {
          "alert": "HighLatencyCritical",
          "expr": "histogram_quantile(0.99, sum by (le, service) (rate(http_server_duration_bucket[5m]))) > 2",
          "for": "10m",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "{{ $labels.service }} p99 above 2s",
            "runbook_url": "https://runbooks.example.com/latency"
          }
        },
        {
          "alert": "HighLatency",
          "expr": "histogram_quantile(0.99, sum by (le, service) (rate(http_server_duration_bucket[5m]))) > 1",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "{{ $labels.service }} p99 above 1s",
            "runbook_url": "https://runbooks.example.com/latency"
          }
        }
      ]
    }
  ]
}
