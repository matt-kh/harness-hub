# CI for {{ repo.name }} (repository standard; jobs from the packs add test and build).
name: ci

on:
  pull_request:
  push:
    branches: [{{ workflow.default_branch }}]

permissions:
  contents: read

jobs:
{{#if quality.ci_jobs has lint}}
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install pre-commit
      - run: pre-commit run --all-files --show-diff-on-failure
{{/if}}
{{slot github_ci_jobs}}
